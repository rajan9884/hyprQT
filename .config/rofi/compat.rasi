/* Compat aliases: old-arch theme names -> current 43pr colors.rasi names.
 * Ported old-arch rasi files @import this instead of colors.rasi directly. */
@import "colors.rasi"

* {
    background:     @bg;
    background-alt: @bg-alt;
    foreground:     @fg;
    active:         @accent;
    selected:       @accent;
}
