#!/usr/bin/env bash
# ──────────────────────────────────────────────
#   Unified Rofi Menu Wrapper (simple style)
#   No -theme flags: everything uses ~/.config/rofi/config.rasi
#   Usage: rofi-menu <mode>
#   Modes: launcher | wallpapers | power | emoji | calc | clipboard | keybinds
# ──────────────────────────────────────────────

set -e

MODE="${1:-$(basename "$0" | sed 's/^menu-//')}"

case "$MODE" in
    launcher|drun)
        rofi -show drun
        ;;
    window)
        rofi -show window
        ;;
    wallpapers|background_menu|wallpaper-menu)
        qs -n -p ~/.config/quickshell/hyprquickpaper
        ;;
    power|power_menu|menu-power)
        OPTIONS="Lock\nLogout\nReboot\nShutdown\nSuspend\nHibernate"
        echo -e "$OPTIONS" | rofi -dmenu -p "Power" | {
            read -r choice
            case "$choice" in
                Lock)     hyprlock ;;
                Logout)   hyprctl dispatch exit ;;
                Reboot)   systemctl reboot ;;
                Shutdown) systemctl poweroff ;;
                Suspend)  systemctl suspend ;;
                Hibernate) systemctl hibernate ;;
            esac
        }
        ;;
    emoji|emoji_menu|menu-emoji)
        rofimoji --selector rofi \
            --clipboarder wl-copy \
            --action type copy \
            --hidden-descriptions \
            --selector-args "-theme-str 'window {width: 720px;}'"
        ;;
    clipboard|clipboard_menu|menu-clipboard)
        # Clipboard: rofi script-mode backend (config/rofi/clipboard.sh).
        # Enter pastes, Ctrl+Enter copies, Shift+Delete removes.
        rofi -show clipboard \
            -modi "clipboard:$HOME/.config/rofi/clipboard.sh" \
            -theme-str 'window {width: 850px;}' -show-icons
        ;;
    clipboard-wipe)
        confirm="$(printf 'No\nYes, wipe history' | rofi -dmenu -p "Wipe clipboard history?")"
        if [ "$confirm" = "Yes, wipe history" ]; then
            cliphist wipe
            # cliphist can reuse numeric ids after a wipe, so drop
            # the per-id decoded image cache used for previews.
            rm -rf -- "${XDG_CACHE_HOME:-$HOME/.cache}/rofi/clipboard-images"
        fi
        ;;
    keybinds|keybinds_menu|menu-keybinds)
        "$HOME/.config/hypr/scripts/keybinds-cheatsheet.sh"
        ;;
    *)
        echo "Unknown mode: $MODE" >&2
        exit 1
        ;;
esac
